{
  "name": "marcy-lab-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/index.js",
    "migrate": "node server/scripts/migrate.js",
    "ingest": "node server/src/ingest.js",
    "eval": "node server/scripts/eval.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "openai": "^4.73.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
