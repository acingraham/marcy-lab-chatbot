# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# Neon Postgres connection string (from neon.tech project Dashboard > Connect)
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# OpenAI API key (from platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: override the embedding and chat models
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Server port (Render sets this automatically in production)
PORT=3000
